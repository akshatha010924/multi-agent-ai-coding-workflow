# ---- LLM ----
LLM_PROVIDER=anthropic            # anthropic | mock  (mock = offline demo/test provider)
ANTHROPIC_API_KEY=                # required when LLM_PROVIDER=anthropic. NEVER commit a real key.
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# ---- Workflow ----
MAX_REVIEW_ITERATIONS=3           # total coder attempts (1..5)
WORKSPACE_DIR=./workspace         # read-only context for the coder; target of apply_changes
APPLY_CHANGES_ENABLED=false       # if false, approved code is returned but never written to disk
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_MB=1024

# ---- Persistence ----
DATABASE_URL=sqlite:///./data/workflows.db

# ---- MCP (documentation tools for the Researcher) ----
MCP_ENABLED=false
MCP_SERVER_COMMAND=npx -y @upstash/context7-mcp
MCP_TIMEOUT_SECONDS=30
MCP_RESOLVE_TOOL=resolve-library-id
MCP_DOCS_TOOL=query-docs
CONTEXT7_API_KEY=                 # optional, raises Context7 rate limits

LOG_LEVEL=INFO
